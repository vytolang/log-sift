// Deciding which records survive.
//
// Every predicate is optional and they AND together. The order they run in is
// chosen by cost: a level comparison is an integer test, a time window is two
// integer tests, and a field query is a scan of the line — so the cheap ones
// reject first and the expensive one runs only on what is left.

import { Record, fieldOf, LV_UNKNOWN } from "log-sift/src/record";
import { NO_TIME } from "log-sift/src/tstamp";

export class Query {
    minLevel: int;         // LV_UNKNOWN means no level filter
    exactLevel: int;       // -1 unless --level-only
    since: i64;            // NO_TIME means unbounded
    until: i64;
    keys: string[];        // --field k=v, parallel arrays
    vals: string[];
    grep: string;          // plain substring, "" for none
    grepV: string;         // exclusion
    caseless: bool;

    fn init() {
        this.minLevel = LV_UNKNOWN;
        this.exactLevel = -1;
        this.since = NO_TIME;
        this.until = NO_TIME;
        this.keys = [];
        this.vals = [];
        this.grep = "";
        this.grepV = "";
        this.caseless = false;
    }

    fn any(): bool {
        return this.minLevel != LV_UNKNOWN || this.exactLevel >= 0 ||
               this.since != NO_TIME || this.until != NO_TIME ||
               this.keys.len > 0 || !this.grep.is_empty() ||
               !this.grepV.is_empty();
    }
}

export fn query(): Query { return new Query(); }

// Does this record pass?
export fn matches(q: Query, r: Record): bool {
    // 1. Level — one integer compare.
    //
    // A line whose level could not be determined is NOT excluded by a
    // threshold. Stack-trace frames and continuation lines carry no level of
    // their own but belong to the error above them, and dropping them turns a
    // useful traceback into a single unexplained line.
    if (q.exactLevel >= 0) {
        if (r.level != q.exactLevel) { return false; }
    } else if (q.minLevel != LV_UNKNOWN) {
        if (r.level != LV_UNKNOWN && r.level < q.minLevel) { return false; }
    }

    // 2. Time window. A line with no timestamp passes: it is almost always a
    // continuation of the line before it, which was already judged.
    if (r.hasTime()) {
        if (q.since != NO_TIME && r.ts < q.since) { return false; }
        if (q.until != NO_TIME && r.ts > q.until) { return false; }
    }

    // 3. Substring tests, before field scans: no parsing involved.
    if (!q.grep.is_empty() && !contains(r.raw, q.grep, q.caseless)) {
        return false;
    }
    if (!q.grepV.is_empty() && contains(r.raw, q.grepV, q.caseless)) {
        return false;
    }

    // 4. Field equality — the expensive one, so it runs last.
    let i = 0;
    while (i < q.keys.len) {
        let want = q.vals[i];
        let got = fieldOf(r, q.keys[i]);
        i += 1;
        if (want == "*") {
            // `--field key=*` asks only that the key be present.
            if (got.is_empty()) { return false; }
            continue;
        }
        if (q.caseless) {
            if (got.to_lower() != want.to_lower()) { return false; }
        } else if (got != want) {
            return false;
        }
    }
    return true;
}

fn contains(hay: string, needle: string, caseless: bool): bool {
    if (!caseless) { return hay.index_of(needle) >= 0; }
    return hay.to_lower().index_of(needle.to_lower()) >= 0;
}

// ---- relative time ------------------------------------------------------

// "5m", "2h", "90s", "3d", "1w" as a count of seconds, or -1.
//
// Only relative durations, not absolute dates: `--since 10:30` is ambiguous
// (which day? whose zone?) in a way that silently produces the wrong window,
// and every real use of --since is "the last N minutes".
export fn parseDuration(s: string): i64 {
    if (s.is_empty()) { return -1; }
    let n = 0;
    let i = 0;
    while (i < s.len && s[i] >= 48 && s[i] <= 57) {
        n = n * 10 + (s[i] - 48);
        i += 1;
    }
    if (i == 0) { return -1; }
    let unit = "s";
    if (i < s.len) { unit = s.slice(i, s.len); }
    let mult = 0;
    if (unit == "s" || unit == "sec") { mult = 1; }
    else if (unit == "m" || unit == "min") { mult = 60; }
    else if (unit == "h" || unit == "hr") { mult = 3600; }
    else if (unit == "d" || unit == "day") { mult = 86400; }
    else if (unit == "w") { mult = 604800; }
    else { return -1; }
    return (n as i64) * (mult as i64);
}
